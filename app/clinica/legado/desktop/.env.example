# Sem chaves: o login é DEMO (sem senha). Copie para .env.local se quiser mudar.
# mock = dados simulados no próprio app (padrão) · api = backend FastAPI
VITE_API_MODO=mock
# Base COM /api/v1. Em outro aparelho da rede, troque localhost pelo IP do computador (ex.: http://192.168.0.10:8000/api/v1).
VITE_API_URL=http://localhost:8000/api/v1
