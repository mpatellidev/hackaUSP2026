# Copie para .env.local. Variáveis EXPO_PUBLIC_* vão para dentro do app: NUNCA coloque chaves ou segredos aqui.

# mock (padrão): dados fictícios de docs/fixtures, sem rede.
# api: usa o backend; rotas que ainda não existem ou falhas de rede caem no mock (com aviso na tela).
EXPO_PUBLIC_API_MODO=mock

# URL do backend sem /api/v1. No celular, use o IP da sua máquina na rede local (não "localhost").
EXPO_PUBLIC_API_URL=http://192.168.0.10:8000
