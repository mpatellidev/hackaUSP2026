# --- IA ---
# gemini (padrão) | claude
LLM_PROVIDER=gemini

# Google Gemini — chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# low | medium | high — "low" deixa as respostas rápidas (bom para chat)
GEMINI_THINKING_LEVEL=low
# modelos reserva, usados em ordem se o principal estiver sobrecarregado
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite

# Anthropic Claude (usado só com LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_FALLBACKS=true

# --- Banco ---
DATABASE_URL=sqlite:///./chat.db

# --- Autenticação ---
# local    = login próprio (usuários seed) — provisório
# external = validar token emitido pelo sistema real (stub, a implementar)
AUTH_PROVIDER=local
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
JWT_EXPIRES_MINUTES=480

# --- Agendamento ---
# mock = dados fictícios em memória | http = sistema real (stub, a implementar)
SCHEDULING_PROVIDER=mock
SCHEDULING_API_URL=

# --- Áudio (TTS) ---
# none = o navegador fala (speechSynthesis) | openai = gera MP3 no servidor
TTS_PROVIDER=none
OPENAI_API_KEY=
OPENAI_TTS_VOICE=nova

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
