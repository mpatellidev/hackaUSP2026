# Copie para .env. Nenhum segredo aqui: o login é DEMO e não usa senha.
# Local (padrão): SQLite em arquivo. NÃO use SQLite no Render (disco efêmero).
DATABASE_URL=sqlite:///./dev.db
# Supabase/Postgres (exemplo, troque pelos seus dados):
# DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@HOST:5432/postgres
DEMO_MODE=true
SESSION_TTL_HOURS=8
CORS_ORIGINS=http://localhost:8081,http://localhost:1420,http://localhost:5173

# --- Chat acessível (#9, app/modulos/acessibilidade) ---
# mock (padrão: sem rede e sem chave) | gemini | claude. Chaves SÓ aqui no servidor, nunca no cliente.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=low
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_FALLBACKS=true
# none = o navegador fala o texto | openai = MP3 gerado no servidor (com cache em TTS_CACHE_DIR)
TTS_PROVIDER=none
OPENAI_API_KEY=
OPENAI_TTS_VOICE=nova
TTS_CACHE_DIR=./tts_cache
