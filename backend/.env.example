# Copie para .env. Nenhum segredo aqui: o login é DEMO e não usa senha.
# Local (padrão): SQLite em arquivo. NÃO use SQLite no Render (disco efêmero).
DATABASE_URL=sqlite:///./dev.db
# Supabase/Postgres (exemplo, troque pelos seus dados):
# DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@HOST:5432/postgres
DEMO_MODE=true
SESSION_TTL_HOURS=8
# 8081 = mobile (Expo web) · 1420 = desktop em dev · 5173 = chat web · tauri.localhost/tauri://localhost = app Tauri instalado.
# Para abrir os apps de OUTRO aparelho na mesma rede (celular), acrescente o IP do computador, ex.:
#   CORS_ORIGINS=...,http://192.168.0.10:8081,http://192.168.0.10:1420,http://192.168.0.10:5173
CORS_ORIGINS=http://localhost:8081,http://localhost:1420,http://localhost:5173,http://127.0.0.1:8081,http://127.0.0.1:1420,http://127.0.0.1:5173,http://tauri.localhost,tauri://localhost
