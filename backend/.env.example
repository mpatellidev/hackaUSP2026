# Copie para .env. Nenhum segredo aqui: o login é DEMO (contas fictícias, senha única de demonstração).
# Local (padrão): SQLite em arquivo. NÃO use SQLite no Render (disco efêmero).
DATABASE_URL=sqlite:///./dev.db
# Supabase/Postgres (exemplo, troque pelos seus dados):
# DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@HOST:5432/postgres
# true: libera o login sem senha e mostra a senha de demo na tela de login. Em ambiente hospedado: false.
DEMO_MODE=true
# Senha única das contas FICTÍCIAS (não é um segredo real). O hash é gravado pelo seed; ao trocar, rode o seed de novo.
# Em ambiente hospedado, defina outra no ambiente do serviço.
DEMO_SENHA=demo1234
SESSION_TTL_HOURS=8
# Só para clientes de OUTRA origem: os apps usam a mesma origem (build servido pela API ou proxy do Vite).
# Para abrir de outro aparelho em modo dev, acrescente o IP do computador, ex.: http://192.168.0.10:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
